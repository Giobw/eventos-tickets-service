{
  "info": {
    "name": "CDY2204 - Eventos Tickets Service",
    "description": "Pruebas del microservicio de tickets (EFS + S3). Cambiar baseUrl a http://<IP-publica-EC2>:8080 para probar el despliegue en la nube.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "ticketId",
      "value": ""
    },
    {
      "key": "ticketId2",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "00 - Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/actuator/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "actuator",
            "health"
          ]
        },
        "description": ""
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Servicio arriba', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "01 - Generar ticket (usuario X, RESERVADO)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/tickets",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "tickets"
          ]
        },
        "description": "Genera el PDF en EFS y lo sube automáticamente a S3 (/evento123/usuarioX/ticketNNNNN.pdf).",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"eventId\": \"evento123\",\n  \"eventName\": \"Concierto Andino\",\n  \"userId\": \"usuarioX\",\n  \"userName\": \"Ana Pérez\",\n  \"seat\": 25000,\n  \"price\": \"RESERVADO\",\n  \"status\": \"A-12\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 Created', () => pm.response.to.have.status(201));",
              "const j = pm.response.json();",
              "pm.collectionVariables.set('ticketId', j.id);",
              "pm.test('Ruta con estructura evento/usuario', () => pm.expect(j.efsPath).to.match(/^evento123\\/usuarioX\\/ticket\\d+\\.pdf$/));",
              "pm.test('Subido automáticamente a S3', () => pm.expect(j.uploadedToS3).to.eql(true));"
            ]
          }
        }
      ]
    },
    {
