          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const j = pm.response.json();",
              "pm.test('Datos actualizados', () => { pm.expect(j.seat).to.eql('VIP-01'); pm.expect(j.status).to.eql('VENDIDO'); });",
              "pm.test('updatedAt informado', () => pm.expect(j.updatedAt).to.not.be.null);"
            ]
          }
        }
