          ]
        },
        "description": "Regenera el PDF en EFS y sobrescribe el objeto en S3.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userName\": \"Ana María Pérez\",\n  \"seat\": \"VIP-01\",\n  \"price\": 45000,\n  \"status\": \"VENDIDO\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
